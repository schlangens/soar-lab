<group name="pfsense,firewall,">
  <rule id="100500" level="3">
    <decoded_as>pf-nohostname</decoded_as>
    <description>pfSense firewall event.</description>
  </rule>

  <!-- Individual blocked traffic - level 2 suppresses from alerts but still feeds frequency rules -->
  <rule id="100501" level="2">
    <if_sid>100500</if_sid>
    <field name="pf_action" type="pcre2">^block$</field>
    <description>pfSense: Blocked traffic $(srcip) -> $(dstip)</description>
    <group>firewall_block,pfsense,</group>
  </rule>

  <!-- Local LAN blocked traffic - completely suppress, no need to track -->
  <rule id="100505" level="0">
    <if_sid>100501</if_sid>
    <srcip>10.0.0.99/24</srcip>
    <description>pfSense: Blocked local LAN traffic (suppressed)</description>
  </rule>

  <rule id="100502" level="2">
    <if_sid>100500</if_sid>
    <field name="pf_action" type="pcre2">^pass$</field>
    <description>pfSense: Passed traffic $(srcip) -> $(dstip)</description>
    <group>firewall_pass,pfsense,</group>
  </rule>

  <!-- High volume blocked from same source -->
  <rule id="100503" level="10" frequency="20" timeframe="30">
    <if_matched_sid>100501</if_matched_sid>
    <same_srcip />
    <description>pfSense: High volume of blocked traffic from $(srcip)</description>
    <group>firewall_block,attack,pfsense,</group>
  
    <options>no_email_alert</options>
  </rule>

  <!-- Flood from same source -->
  <rule id="100504" level="12" frequency="50" timeframe="60">
    <if_matched_sid>100501</if_matched_sid>
    <same_srcip />
    <description>pfSense: Flood of blocked traffic from $(srcip) - likely attack</description>
    <group>firewall_block,attack,pfsense,</group>
  
    <options>no_email_alert</options>
  </rule>

  <!-- Suppress high-volume block from Cloudflare infrastructure (198.41.128.0/17 is Cloudflare-owned) -->
  <rule id="100510" level="0">
    <if_sid>100503,100504</if_sid>
    <srcip>198.41.128.0/17</srcip>
    <description>Suppressing block alert from Cloudflare infrastructure</description>
  </rule>

  <!-- Suppress high-volume block from Tailscale coordination -->
  <rule id="100511" level="0">
    <if_sid>100503,100504</if_sid>
    <srcip>199.165.136.0/24</srcip>
    <description>Suppressing block alert from Tailscale coordination</description>
